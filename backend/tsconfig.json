{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "incremental": true,
        "lib": [
            "esnext"
        ],
        "types": [
            "node",
            "jest"
        ],
        "plugins": [
            {
                "transform": "typia/lib/transform"
            }
        ],
        "paths": {
            "@backend/*": [
                "./*"
            ],
            "@prisma-generated/*": [
                "./generated/prisma/*"
            ]
        },
        "inlineSourceMap": true,
        "inlineSources": true,
        "verbatimModuleSyntax": false,
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "**/*.ts"
    ]
}
